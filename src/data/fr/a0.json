            ["blanc", "blanche", "wit"],
            ["orange", "orange", "oranje"],
            ["rose", "rose", "roze"],
            ["violet", "violette", "paars"],
            ["gris", "grise", "grijs"],
            ["marron", "marron", "bruin"]
          ]
        },
        {
          "type": "note",
          "content": "Marron (bruin) en orange veranderen nooit van vorm — ze zijn altijd hetzelfde voor mannelijk, vrouwelijk en meervoud."

  "topics": [
    {
      "id": "fr-a0-begroetingen",
      "title": "Begroetingen & afscheid",
      "description": "Hoe zeg je hallo, tot ziens en goeiedag in het Frans.",
      "theory": [
        {
          "type": "text",
          "content": "In het Frans is er een verschil tussen formeel (met vreemden of volwassenen) en informeel (met vrienden). Dit is belangrijk om te onthouden."
        },
        {
          "type": "table",
          "headers": ["Frans", "Uitspraak", "Betekenis", "Gebruik"],
          "rows": [
            ["Bonjour", "bon-zjur", "Goeiedag / Goedemorgen", "Formeel, overdag"],
            ["Bonsoir", "bon-swar", "Goeienavond", "Formeel, 's avonds"],
            ["Salut", "sa-lü", "Hallo / Dag", "Informeel"],
            ["Bonne nuit", "bon nwi", "Welterusten", "Altijd"],
            ["Au revoir", "o-ruh-vwar", "Tot ziens", "Formeel"],
            ["À bientôt", "a bjen-toh", "Tot gauw", "Informeel/formeel"],
            ["À demain", "a duh-meh", "Tot morgen", "Altijd"]
          ]
        },
        {
          "type": "note",
          "content": "\"Salut\" betekent zowel hallo als dag — je kan het gebruiken bij aankomst én vertrek."
        },
        {
          "type": "example",
          "pairs": [
            { "left": "Bonjour, madame!", "right": "Goeiedag, mevrouw!" },
            { "left": "Salut, ça va?", "right": "Hé, gaat het?" },
            { "left": "Au revoir et à bientôt!", "right": "Tot ziens en tot gauw!" },
            { "left": "Bonne nuit, dors bien.", "right": "Welterusten, slaap goed." }
          ]
        }
      ],
      "exercises": [
